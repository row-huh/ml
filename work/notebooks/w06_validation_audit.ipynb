    "        \"Title/snippet rewrite is cheaper and lower-risk than full content refresh. If a page's low CTR stems from poor metadata (vs. poor quality or misaligned intent), the ranking can help identify which pages to review first.\"\n",
    "    ]\n",
    "}\n",
    "\n",
    "rewrites = pd.DataFrame(claims)\n",
    "print(\"BOLD vs. SAFE LANGUAGE:\")\n",
    "print()\n",
    "for i in range(len(rewrites)):\n",
    "    print(f\"{i+1}. BOLD (before):\")\n",
    "    print(f\"   {rewrites['Bold (before)'].iloc[i]}\")\n",
    "    print()\n",
    "    print(f\"   SAFE (after):\")\n",
    "    print(f\"   {rewrites['Safe (after)'].iloc[i]}\")\n",
    "    print()\n",
    "\n",
    "print(\"KEY PATTERNS:\")\n",
    "print(\"  'X predicts Y' → 'X correlates with Y in this data (r = ...)'\")\n",
    "print(\"  'The model does X' → 'The model can be used to rank by X; humans decide'\")\n",
    "print(\"  'This is a fix' → 'This may help if the root cause is ...; validation needed'\")"
